cabal-version:      3.0
name:               siza-client
version:            0.1.0.0
synopsis:           Compiled Haskell client for the Sabela AI tool surface.
description:        Typed CLI + library that drives a running Sabela notebook
                    over /api/ai/*, with a client-side pre-flight (parse +
                    security) pipeline. Replaces siza-discover.sh/siza-tool.sh.
build-type:         Simple
license:            MIT
license-file:       LICENSE
author:             DataHaskell
maintainer:         mschavinda@gmail.com
category:           Development

source-repository head
    type:     git
    location: https://github.com/DataHaskell/sabela
    subdir:   siza-client

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    default-extensions: OverloadedStrings, LambdaCase
    exposed-modules:
                      -- Bounded context: Episode
                      Siza.Agent.Loop
                      Siza.Agent.Loop.Types
                      Siza.Agent.Loop.Step
                      Siza.Agent.Loop.Episode
                      Siza.Agent.Loop.Support
