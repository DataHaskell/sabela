                      Siza.Agent.Loop.Sampling
                      Siza.Agent.Sample
                      Siza.Agent.Stack
                      Siza.Agent.Stack.Call
                      Siza.Agent.Stack.Route
                      Siza.Agent.ToolRoute
                      Siza.Agent.Tools
                      Siza.Agent.Tools.Catalogue
                      Siza.Agent.Chat
                      Siza.Agent.Chat.Export
                      Siza.Agent.Messages
                      Siza.Agent.Render
                      Siza.Agent.Ack
                      Siza.Agent.Bulk
                      Siza.Agent.Scaffold
                      -- Bounded context: Gating / repair
                      Siza.Preflight
                      Siza.Agent.Owned
                      Siza.Agent.Repair
                      Siza.Agent.Repair.Blocking
                      Siza.Agent.RepairGuard
                      Siza.Agent.RepairLocate
                      Siza.Agent.RepairTiers
