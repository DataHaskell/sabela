                      Siza.Agent.VerifyMemo
                      Siza.Agent.VerifyTool
                      Siza.Agent.RenderContract
                      Siza.Agent.Deliverable
                      -- Bounded context: Discovery
                      Siza.Agent.DiscoverTool
                      Siza.Agent.GrammarCards
                      -- compatibility alias for eval/neuro-symbolic
                      Siza.Agent.Discover
                      Siza.Agent.Discover.Types
                      Siza.Agent.Discover.CabalFacts
                      Siza.Agent.Discover.Absent
                      Siza.Agent.Discover.Interpret
                      Siza.Agent.Discover.UnitName
                      Siza.Agent.Discover.Classify
                      Siza.Agent.Discover.CardRows
                      Siza.Agent.Discover.CardAuthority
                      Siza.Agent.Discover.HitJson
                      Siza.Agent.Discover.SessionAnswer
                      Siza.Agent.Discover.Affordance
                      Siza.Agent.Discover.Installed
                      Siza.Agent.Discover.Mode
                      Siza.Agent.Discover.Merge
                      Siza.Agent.Discover.Rank
                      Siza.Agent.Discover.Render
                      Siza.Agent.Discover.Resolved
                      Siza.Agent.Discover.ScopeFilter
                      Siza.Agent.Discover.ModuleList
                      Siza.Agent.Discover.Inventory
                      Siza.Agent.Discover.Fetch
                      Siza.Agent.Discover.Guidance
                      Siza.Agent.Discover.Envelope
                      Siza.Agent.Discover.Evict
                      Siza.Agent.Discover.FactSelect
                      Siza.Agent.Discover.Exact
                      Siza.Agent.Discover.Construct
                      Siza.Agent.Discover.Goal
                      Siza.Agent.Discover.GoalEscalate
                      Siza.Agent.Discover.Literal
                      Siza.Agent.Discover.ProducerCard
                      Siza.Agent.Discover.Ledger
                      Siza.Agent.Discover.Request
                      Siza.Agent.Discover.Advice
                      Siza.Agent.Discover.Beside
                      Siza.Agent.Discover.Candidate
                      Siza.Agent.Discover.Facts
                      Siza.Agent.Discover.HoleProbe
                      Siza.Agent.Discover.MissLadder
                      Siza.Agent.Discover.Closure
                      Siza.Agent.Discover.Steer
                      Siza.Agent.Discover.History
                      Siza.Agent.Discover.Dedup
                      Siza.Agent.Discover.HistoryGuard
                      Siza.Agent.Discover.Hackage
                      -- Bounded context: Context economy
                      Siza.Agent.Compact
                      Siza.Agent.EmitLedger
                      Siza.Agent.OutcomeDistill
                      Siza.Agent.Recall
                      Siza.Agent.Exemplars
                      Siza.Agent.NoteLedger
                      -- Bounded context: Observation
                      Siza.Agent.Transcript
                      Siza.Annotate
                      Siza.Provenance
                      Siza.Provenance.Event
                      Siza.Provenance.Log
                      Siza.Retro
                      Siza.Retro.Episode
                      Siza.Retro.Result
                      Siza.Retro.Metrics
                      Siza.Retro.Distribution
                      Siza.Retro.Report
                      -- Infrastructure adapters
                      Siza.Discover
                      Siza.Transport
                      Siza.Transport.Failure
                      Siza.HubToken
                      Siza.Login
                      Siza.Security
                      Siza.Language
                      Siza.Lang.Haskell
                      Siza.Agent.ProviderCheck
                      -- compatibility alias for eval/neuro-symbolic
                      Siza.Agent.Preflight
                      Siza.Cli
                      Siza.Cli.Annotate
                      Siza.Cli.Chat
                      Siza.Cli.Await
                      Siza.Cli.Options
                      Siza.Cli.Provenance
                      Siza.Cli.Retro
                      Siza.Mcp
                      Siza.Mcp.Surface
                      Siza.Mcp.Rpc
                      Siza.Mcp.Serve
                      -- Guides
                      Siza.Guide
    other-modules:    Siza.Agent.Owned.Snapshot
                      Siza.Agent.Stack.Reconcile
    build-depends:    base >= 4 && < 5
                      -- the contract sub-library: typed wire DTOs + AST parser
                      -- reuse, without the server's warp/servant/process drag
                    , sabela:sabela-contract >= 0.1 && < 0.2
                      -- transport (already in-project; server uses the same)
                    , http-client >= 0.7 && < 0.10
                    , http-client-tls >= 0.3 && < 0.4
                    , http-types >= 0.12 && < 0.13
                    , aeson >= 2.0 && < 3
                    , bytestring >= 0.10 && < 0.13
                    , text >= 1.2 && < 3
                    , containers >= 0.6.7 && < 0.9
                    , directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                      -- siza login: open the authorize URL in the browser
                    , process >= 1.6 && < 1.8
                      -- provenance log timestamps (UTCTime)
                    , time >= 1.9 && < 2
                      -- opt-in hash-chain over the provenance log (SHA-256);
                      -- already in the build plan via http-client-tls/tls
                    , crypton >= 0.30 && < 2
                      -- typed CLI surface
                    , optparse-applicative >= 0.17 && < 0.20
                      -- parse-with-location: the SAME parser Sabela.Parse
                      -- uses, pinned to the SAME bounds so they stay lockstep
                    , ghc-lib-parser >= 9.6 && < 9.20
                    , ghc-lib-parser-ex >= 9.6 && < 9.20
    -- POSIX file modes for the 0600 hub-token file; Windows uses ACLs (CPP no-op)
    if !os(windows)
        build-depends: unix >= 2.7 && < 2.9

executable siza
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base >= 4 && < 5
                    , siza-client

-- The payload-truth gate. Run by scripts/payload-probe.sh against a throwaway
-- server; deliberately NOT a test-suite, since it needs a live backend.
executable siza-probe
    import:           warnings
    hs-source-dirs:   probe
    main-is:          Main.hs
    other-modules:    Probe.Check
                      Probe.Claim
                      Probe.Oracle
                      Probe.Record
    default-language: Haskell2010
    default-extensions: OverloadedStrings, LambdaCase
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base >= 4 && < 5
                    , siza-client
                    , sabela >= 0.1 && < 0.2
                    , sabela:sabela-contract >= 0.1 && < 0.2
                    , aeson >= 2.0 && < 3
                    , containers >= 0.6.7 && < 0.9
                    , directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , process >= 1.6 && < 1.8
                    , text >= 1.2 && < 3

-- Builds the local Hackage facts cache from the cabal index tar. Run by
-- tools/update-search-cache.sh, never at query time.
executable siza-hackage-facts
    import:           warnings
    hs-source-dirs:   hackage-facts
    main-is:          Main.hs
    default-language: Haskell2010
    default-extensions: OverloadedStrings, LambdaCase
    ghc-options:      -rtsopts
    build-depends:    base >= 4 && < 5
                    , siza-client
                    , bytestring >= 0.11 && < 0.13
                    , containers >= 0.6.7 && < 0.9
                    , directory >= 1.3 && < 1.4
                    , filepath >= 1.4 && < 1.6
                    , sabela:sabela-contract >= 0.1 && < 0.2
                    , tar >= 0.5 && < 0.7
                    , text >= 1.2 && < 3

-- Run EXPLICITLY by target
-- (cabal test siza-client:test:siza-client-test), never `cabal test all`.
